# Copy one configuration mode to .env.local before starting the app.
# Preferred: up to 16 source objects with unique lowercase ids. Roots must be
# absolute. Use agent "shared" for neutral/shared sources. Keep this JSON on one
# line in dotenv files. Never commit real user paths or secrets.
SKILL_SOURCES_JSON=[{"id":"codex","label":"Codex skills","agent":"codex","root":"/absolute/path/to/codex/skills"},{"id":"shared","label":"Shared skills","agent":"shared","root":"/absolute/path/to/shared/skills"}]

# Legacy single-source fallback. This is read only when SKILL_SOURCES_JSON is
# absent; a present but malformed JSON value fails closed and never falls back.
# SKILLS_ROOT=/absolute/path/to/skills
